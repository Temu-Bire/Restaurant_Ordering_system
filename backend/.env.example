# Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arif_food?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/arif_food?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/arif_food?schema=public"

# Application and Security
PORT=3000
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_random_base64_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Chapa Payment Gateway Configuration
# Mode: TEST or LIVE
CHAPA_ENVIRONMENT=TEST
CHAPA_SECRET_KEY=CHAPA_TEST_PRIV_your_secret_key
CHAPA_PUBLIC_KEY=CHAPA_TEST_PUB_your_public_key
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_signature
CHAPA_BASE_URL=https://api.chapa.co/v1

# Optional Seed Credentials
SEED_DEFAULT_PASSWORD=ChangeThisStrongPassword123!
