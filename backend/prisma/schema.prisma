// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

// ───────────────────────── FR-01: Users ─────────────────────────

model User {
  id             String    @id @default(uuid())
  fullName       String
  email          String    @unique
  phone          String?
  address        String?
  avatarUrl      String?
  password       String // bcrypt hash, never return it in API responses
  role           Role      @default(CUSTOMER)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orders         Order[]
  payments       Payment[]       @relation("CustomerPayments")
  recordedPayments Payment[]     @relation("RecordedPayments")
  addresses      Address[]
  notifications  Notification[]
  handoverOrders Order[]         @relation("HandoverStaff")
  stockMovements StockMovement[]
  reviews          Review[]
  moderatedReviews Review[]        @relation("ModeratedReviews")
}

// ───────────────────────── Delivery Addresses ─────────────────────────

model Address {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label                String   // "Home", "Work", "Other"
  recipientName        String
  phone                String
  city                 String
  area                 String   // neighborhood
  street               String
  landmark             String?
  building             String?
  apartment            String?
  deliveryInstructions String?
  latitude             Decimal  @db.Decimal(10, 7)
  longitude            Decimal  @db.Decimal(10, 7)
  isDefault            Boolean  @default(false)
  orders               Order[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

// ───────────────────────── FR-02: Menu ─────────────────────────

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  foods     Food[]
  createdAt DateTime @default(now())
}

model Food {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  price       Decimal      @db.Decimal(10, 2) // money is never a float
  imagePath   String? // relative path like /uploads/menu/abc.jpg
  isAvailable Boolean      @default(true)
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]
  recipes     RecipeLine[]
  reviews     Review[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId])
}

// ───────────────────────── FR-03: Orders ─────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum PaymentMethod {
  MOBILE
}

model Order {
  id                  String           @id @default(uuid())
  number              Int              @unique @default(autoincrement())
  customerId          String
  customer            User             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type                OrderType
  status              OrderStatus      @default(PENDING)
  paymentStatus       PaymentStatus    @default(UNPAID)
  partySize           Int?             // For Dine-in
  prepTimeMinutes     Int?             // Estimated food preparation arrival guidance
  tableId             String?
  table               RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableLabel          String?
  heldUntil           DateTime?        // Temporary table hold during checkout payment
  addressId           String?
  address             Address?         @relation(fields: [addressId], references: [id], onDelete: SetNull)
  deliveryDistanceKm  Decimal?         @db.Decimal(5, 2)
  deliveryAddressText String?
  pickupInstructions  String?          // For Takeaway
  subtotal            Decimal          @db.Decimal(10, 2)
  deliveryFee         Decimal          @default(0) @db.Decimal(10, 2)
  tax                 Decimal          @default(0) @db.Decimal(10, 2)
  total               Decimal          @db.Decimal(10, 2)
  stockAdjusted       Boolean          @default(true)
  handoverStaffId     String?
  handoverStaff       User?            @relation("HandoverStaff", fields: [handoverStaffId], references: [id], onDelete: SetNull)
  handoverAt          DateTime?
  handoverNotes       String?
  items               OrderItem[]
  payment             Payment?
  reviews             Review[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodId    String
  food      Food    @relation(fields: [foodId], references: [id], onDelete: Restrict)
  name      String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int
  review    Review?

  @@index([orderId])
  @@index([foodId])
}

// ───────────────────────── Food Reviews & Ratings ─────────────────────────

model Review {
  id               String    @id @default(uuid())
  foodId           String
  food             Food      @relation(fields: [foodId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId      String    @unique
  orderItem        OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int       // 1 to 5 stars
  comment          String?
  isHidden         Boolean   @default(false)
  moderationReason String?
  moderatedById    String?
  moderatedBy      User?     @relation("ModeratedReviews", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([foodId, isHidden])
  @@index([userId])
  @@index([orderId])
  @@index([createdAt])
}

// ───────────────────────── FR-04: Payments ─────────────────────────

model Payment {
  id            String        @id @default(uuid())
  receipt       String?       @unique
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      User?         @relation("CustomerPayments", fields: [customerId], references: [id], onDelete: SetNull)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("ETB")
  method        PaymentMethod @default(MOBILE)
  status        PaymentStatus @default(UNPAID)
  paid          Boolean       @default(false)
  provider      String?       // e.g. "Telebirr", "CBE Birr", "Chapa"
  transactionId String?
  txRef         String?       @unique
  paymentUrl    String?
  checkoutUrl   String?
  verifiedAt    DateTime?
  recordedById  String?
  recordedBy    User?         @relation("RecordedPayments", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([txRef])
  @@index([customerId])
}

// ───────────────────────── Notifications ─────────────────────────

enum NotificationType {
  ORDER_CONFIRMATION
  ORDER_STATUS_UPDATE
  PAYMENT_SUCCESS
  PAYMENT_FAILURE
  PAYMENT_ISSUE
  NEW_ORDER
  ORDER_CANCELLED
  USER_REGISTRATION
  SYSTEM_EVENT
}

model Notification {
  id              String           @id @default(uuid())
  recipientUserId String
  recipient       User             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  title           String
  message         String
  type            NotificationType
  relatedEntityId String?
  isRead          Boolean          @default(false)
  readAt          DateTime?
  idempotencyKey  String?          @unique
  createdAt       DateTime         @default(now())

  @@index([recipientUserId, isRead])
  @@index([recipientUserId, createdAt])
  @@index([idempotencyKey])
}

// ───────────────────────── FR-05: Inventory ─────────────────────────

enum InventoryCategory {
  INGREDIENTS
  BEVERAGES
  DRY_GOODS
  PACKAGING
  SUPPLIES
}

enum InventoryStatus {
  ACTIVE
  INACTIVE
}

enum MovementType {
  RECEIVE
  WASTE
  COUNT
  ADJUSTMENT
  ORDER_CONSUMPTION
}

model Ingredient {
  id              String            @id @default(uuid())
  name            String            @unique
  category        InventoryCategory @default(INGREDIENTS)
  sku             String?
  stock           Decimal           @default(0) @db.Decimal(10, 3)
  minimum         Decimal           @default(5) @db.Decimal(10, 3)
  unit            String            @default("kg") // kg, g, L, ml, pcs, packs, bottles, cans, boxes
  unitCost        Decimal           @default(0) @db.Decimal(10, 2)
  expiryDate      DateTime?
  storageLocation String?
  status          InventoryStatus   @default(ACTIVE)
  recipes         RecipeLine[]
  movements       StockMovement[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([sku])
  @@index([category])
  @@index([status])
}

model StockMovement {
  id               String       @id @default(uuid())
  ingredientId     String
  ingredient       Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  type             MovementType
  quantityChanged  Decimal      @db.Decimal(10, 3)
  previousQuantity Decimal      @db.Decimal(10, 3)
  newQuantity      Decimal      @db.Decimal(10, 3)
  reason           String?
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())

  @@index([ingredientId])
  @@index([type])
  @@index([createdAt])
}

model RecipeLine {
  id           String     @id @default(uuid())
  foodId       String
  food         Food       @relation(fields: [foodId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Decimal    @db.Decimal(10, 3)

  @@unique([foodId, ingredientId])
}

// ───────────────────────── FR-06: Tables ─────────────────────────

enum TableStatus {
  AVAILABLE
  FREE
  RESERVED
  OCCUPIED
  CLEANING
}

model RestaurantTable {
  id            String      @id @default(uuid())
  name          String      @unique
  seats         Int
  status        TableStatus @default(AVAILABLE)
  section       String?     // e.g. "Main Dining", "Window Side", "Balcony"
  activeOrderId String?
  heldUntil     DateTime?
  orders        Order[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ───────────────────────── Delivery Tier Configuration ─────────────────────────

model DeliveryTier {
  id          String   @id @default(uuid())
  minDistance Decimal  @db.Decimal(5, 2) // km
  maxDistance Decimal  @db.Decimal(5, 2) // km
  fee         Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ───────────────────────── FR-07: Settings ─────────────────────────

model Settings {
  id                     String   @id @default("default")
  name                   String   @default("Arif Food")
  phone                  String   @default("+251 11 XXX XXXX")
  address                String   @default("Bole, Addis Ababa")
  currency               String   @default("ETB")
  taxRate                Decimal  @default(15) @db.Decimal(5, 2)
  dineInEnabled          Boolean  @default(true)
  takeawayEnabled        Boolean  @default(true)
  deliveryEnabled        Boolean  @default(true)
  deliveryFee            Decimal  @default(50) @db.Decimal(10, 2)
  restaurantLat          Decimal? @default(9.005401) @db.Decimal(10, 7)
  restaurantLng          Decimal? @default(38.763611) @db.Decimal(10, 7)
  maxDeliveryDistanceKm  Decimal  @default(15) @db.Decimal(5, 2)
  minDeliveryOrderAmount Decimal  @default(0) @db.Decimal(10, 2)
  cashEnabled            Boolean  @default(false)
  cardEnabled            Boolean  @default(false)
  mobileEnabled          Boolean  @default(true)
  lowStockMinimum        Decimal  @default(5) @db.Decimal(10, 3)
  updatedAt              DateTime @updatedAt
}
